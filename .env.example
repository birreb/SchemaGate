# Copy to .env and fill in. Never commit .env.

# Each connection is one variable. The key after the double underscore is the
# name callers pass as `connection`. A connection string is never accepted over
# HTTP, so a caller can only reach a database registered here.
# From inside Docker, use host.docker.internal to reach a database on the host.
SCHEMAGATE_CONNECTIONS__primary=postgresql://user:password@localhost:5432/mydb
# SCHEMAGATE_CONNECTIONS__reporting=postgresql://user:password@localhost:5432/other

# Largest accepted upload, in bytes. Enforced before the body is read.
SCHEMAGATE_MAX_UPLOAD_BYTES=10485760

# Where a local Ollama server is listening, if you use one.
# SCHEMAGATE_OLLAMA_HOST=http://localhost:11434
# SCHEMAGATE_OLLAMA_MODEL=qwen3

# Lets the playground choose a provider and send its API key with a request,
# instead of setting one here. That means a credential crosses HTTP, so it is
# off unless you turn it on, and it should stay off anywhere reachable by
# people you do not trust.
# SCHEMAGATE_ALLOW_REQUEST_CREDENTIALS=true

# Which model service to use when a request does not name one. Without this,
# documents needing a model are refused rather than sent anywhere.
# SCHEMAGATE_PROVIDER=anthropic          # or openai, openai_compatible, ollama
# SCHEMAGATE_ANTHROPIC_MODEL=claude-opus-5
# SCHEMAGATE_OPENAI_MODEL=gpt-5
# SCHEMAGATE_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# API keys are read by the SDKs themselves, from ANTHROPIC_API_KEY and
# OPENAI_API_KEY, so this project never handles them.

# Arithmetic checks per table, keyed by qualified name. This one needs JSON
# because it has structure, and the single quotes are required: without them
# `uv run --env-file` refuses to parse the line.
# Free text passed to the model with a document, per table. For the things a
# schema cannot say. A request may override it.
# SCHEMAGATE_INSTRUCTIONS='{"public.invoices": "This supplier writes dates day first."}'

# Checks the schema cannot express. Four kinds: a sum, a product, values a
# column can never hold (your own VAT number as a supplier's), and a shape.
# SCHEMAGATE_RULES='{"public.invoices": [{"terms": ["subtotal", "tax"], "equals": "total"}, {"column": "vat_id", "reject": ["SE559012345601"]}, {"column": "vat_id", "pattern": "[A-Z]{2}[A-Z0-9]{2,12}"}], "public.invoice_lines": [{"factors": ["quantity", "unit_price"], "equals": "line_total"}]}'

# --- What it costs -----------------------------------------------------------

# What each model costs, per million tokens, as published on the provider's
# pricing page. Without this, every response still reports its tokens and
# reports `cost_usd` as null, because a price nobody configured cannot be
# invented and a wrong number presented as an answer is worse than none.
# `cached_input` is optional; left out, cached tokens are billed at the input
# rate, which overstates rather than understates.
# SCHEMAGATE_PRICES='{"claude-opus-5": {"input": 5, "output": 25, "cached_input": 0.5}, "claude-haiku-4-5": {"input": 1, "output": 5}}'

# How hard the model is asked to think, where the provider exposes it.
# Extraction against a compiled schema has nothing to deliberate about: the
# shape of the answer is already fixed and the work is reading carefully. The
# current models think by default at high effort, so the default here is `low`.
# Set it empty to send nothing at all, which is what an older model needs.
# SCHEMAGATE_EFFORT=low                  # low, medium, high, xhigh, max

# The model used to match a column heading to a column by meaning, when the
# spelling does not. That is a lookup over two short lists, not a reading task.
# Unset, the extraction model does both, at extraction prices.
# SCHEMAGATE_HEADER_MODEL=claude-haiku-4-5

# --- Who may call it ---------------------------------------------------------

# Keys a caller must present, as `Authorization: Bearer <key>` or `X-API-Key`.
# Comma separated, or JSON. Empty means the endpoints are open, which is fine
# behind your own application and not fine anywhere else: every extraction
# spends money and every table listing describes your schema. Set two during a
# rotation so it is not an outage.
# SCHEMAGATE_API_KEYS=sk-one,sk-two

# Requests per minute, counted per key when keys are set and per client address
# when they are not. 0 turns it off.
# SCHEMAGATE_RATE_LIMIT_PER_MINUTE=60

# How many documents may be read at once. Each holds its upload, its rendered
# pages and its answer in memory, and OCR is CPU bound, so an unbounded arrival
# rate becomes thrashing rather than throughput. 0 removes the bound.
# SCHEMAGATE_MAX_CONCURRENT_EXTRACTIONS=8
