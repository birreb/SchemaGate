# Copy to .env and fill in. Never commit .env.

# Each connection is one variable. The key after the double underscore is the
# name callers pass as `connection`. A connection string is never accepted over
# HTTP, so a caller can only reach a database registered here.
# From inside Docker, use host.docker.internal to reach a database on the host.
SCHEMAGATE_CONNECTIONS__primary=postgresql://user:password@localhost:5432/mydb
# SCHEMAGATE_CONNECTIONS__reporting=postgresql://user:password@localhost:5432/other

# Largest accepted upload, in bytes. Enforced before the body is read.
SCHEMAGATE_MAX_UPLOAD_BYTES=10485760

# Where a local Ollama server is listening, if you use one.
# SCHEMAGATE_OLLAMA_HOST=http://localhost:11434
# SCHEMAGATE_OLLAMA_MODEL=qwen3

# Lets the playground choose a provider and send its API key with a request,
# instead of setting one here. That means a credential crosses HTTP, so it is
# off unless you turn it on, and it should stay off anywhere reachable by
# people you do not trust.
# SCHEMAGATE_ALLOW_REQUEST_CREDENTIALS=true

# Which model service to use when a request does not name one. Without this,
# documents needing a model are refused rather than sent anywhere.
# SCHEMAGATE_PROVIDER=anthropic          # or openai, openai_compatible, ollama
# SCHEMAGATE_ANTHROPIC_MODEL=claude-opus-5
# SCHEMAGATE_OPENAI_MODEL=gpt-5
# SCHEMAGATE_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# API keys are read by the SDKs themselves, from ANTHROPIC_API_KEY and
# OPENAI_API_KEY, so this project never handles them.

# Arithmetic checks per table, keyed by qualified name. This one needs JSON
# because it has structure, and the single quotes are required: without them
# `uv run --env-file` refuses to parse the line.
# Free text passed to the model with a document, per table. For the things a
# schema cannot say. A request may override it.
# SCHEMAGATE_INSTRUCTIONS='{"public.invoices": "This supplier writes dates day first."}'

# SCHEMAGATE_RULES='{"public.invoices": [{"terms": ["subtotal", "tax"], "equals": "total"}]}'
