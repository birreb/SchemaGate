# Copy to .env and fill in. Never commit .env.

# Named database connections, as JSON. The key is what callers pass as
# `connection`. A connection string is never accepted over HTTP, so a caller
# can only reach a database registered here.
# From inside Docker, use host.docker.internal to reach a database on the host.
SCHEMAGATE_CONNECTIONS={"primary": "postgresql://user:password@host.docker.internal:5432/mydb"}

# Largest accepted upload, in bytes. Enforced before the body is read.
SCHEMAGATE_MAX_UPLOAD_BYTES=10485760

# Where a local Ollama server is listening. Leave unset and documents that need
# a model are refused rather than sent anywhere.
# SCHEMAGATE_OLLAMA_HOST=http://host.docker.internal:11434
# SCHEMAGATE_OLLAMA_MODEL=qwen3

# Arithmetic checks per table, keyed by qualified name.
# SCHEMAGATE_RULES={"public.invoices": [{"terms": ["subtotal", "tax"], "equals": "total"}]}
